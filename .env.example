# backend (pydantic-settings; локально DATA_DIR за замовчуванням = <repo>/data)
ENV=local
# DATA_DIR=/data
# DB_PATH=/data/build/flame.duckdb
# кеш моделі ембеддингів RAG (дефолт <DATA_DIR>/models; в образі /app/models)
# MODELS_DIR=/app/models
CORS_ORIGINS=["http://localhost:5173"]

# агент (flame.agent): ключ Claude API — лише тут / у змінних Railway, не в коді
# ANTHROPIC_API_KEY=
# AGENT_MODEL=claude-sonnet-5-5
# AGENT_EFFORT=medium
# AGENT_MAX_STEPS=8
# AGENT_RATE_PER_MINUTE=5
# AGENT_RATE_PER_DAY=50
# AGENT_BUDGET_USD=10

# frontend (вшивається при збірці; локально не потрібен — працює проксі Vite)
# VITE_API_URL=https://<backend>.up.railway.app

# Railway: архіви знімків, які bootstrap розпаковує на Volume (качає лише нові URL)
# DATA_ARCHIVE_URLS=["https://github.com/MartyniukAleksei/nasa-2026/releases/download/data-flex-v1/flex-v1.zip","https://github.com/MartyniukAleksei/nasa-2026/releases/download/data-psi-studies-v1/psi-studies-v1.zip"]
# старий одиночний варіант (лише FLEX), підтримується далі:
# DATA_ARCHIVE_URL=https://github.com/MartyniukAleksei/nasa-2026/releases/download/data-flex-v1/flex-v1.zip
